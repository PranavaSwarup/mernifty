# Copy this file to server/.env and adjust. Values here are safe development defaults.

# --- Core ---
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB connection. In development, if this cannot be reached the server starts an
# in-memory database instead (data is lost on restart). In production it is required.
MONGODB_URI=mongodb://localhost:27017/metropulse

# Secret used to sign login tokens. In production this must be a private value of at
# least 24 characters; the server refuses to start with the development default.
JWT_SECRET=metropulse_super_secret_jwt_key_2026_dev

# --- Access ---
# Demo persona switcher (one-click logins for Supervisor, zone operators, viewer).
# Defaults to on outside production and off in production. Set explicitly to override.
# DEMO_PERSONAS=true
# Allow read-only API access without logging in (default true).
# PUBLIC_READONLY=true
# Device API key for external producers and the stress test. One is generated at first
# start and written to server/.env.local-keys; set this to use your own.
# METROPULSE_API_KEY=

# --- Ingestion ---
BATCH_INTERVAL_MS=500
BATCH_SIZE=200
# How long telemetry is kept in MongoDB, in seconds (default 7200 = 2 hours).
# TELEMETRY_TTL_SEC=7200
# Token-bucket rate limits (events) for keyed and anonymous callers.
# RATE_LIMIT_AUTH_CAPACITY=
# RATE_LIMIT_AUTH_REFILL_PER_SEC=
# RATE_LIMIT_ANON_CAPACITY=
# RATE_LIMIT_ANON_REFILL_PER_SEC=

# --- Simulator ---
SIMULATOR_ENABLED=true
# SIM_EMIT_HZ=2
# SIM_SPEED=1
# SIM_SEED=

# --- OpenTelemetry (optional) ---
# OTEL_SDK_DISABLED=true
# OTEL_SERVICE_NAME=metropulse-blr
# OTEL_SAMPLE_RATIO=0.05
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
