{
  "name": "hyperpulse-server",
  "version": "1.0.0",
  "type": "module",
  "description": "High-Throughput Streams & Telemetry Monitoring Platform Backend",
  "main": "src/index.js",
  "scripts": {
    "start": "node --import ./src/telemetry/otel.js src/index.js",
    "dev": "node --watch --import ./src/telemetry/otel.js src/index.js",
    "test": "node --test --test-timeout=90000 test/*.test.js"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
